# ── Bolo build-time environment variables ─────────────────────────
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored and MUST NEVER be committed.
#
# These keys are used only by scripts/generate_tts.py at build time
# to pre-generate MP3 audio assets. The shipped Flutter app makes zero
# runtime calls to these services.

# ── Azure Neural TTS (Hindi voice: hi-IN-SwaraNeural) ─────────────
# Sign up: https://portal.azure.com → create a "Speech" resource
# Free tier: 500K characters/month neural TTS
AZURE_TTS_KEY=
AZURE_TTS_REGION=eastus

# ── ElevenLabs (English voices — optional; Piper local is default) ─
# Only set if you decide to use ElevenLabs instead of Piper for English
# Sign up: https://elevenlabs.io → account → API key
ELEVENLABS_API_KEY=

# ── Sentry (runtime crash reporting only, PII-scrubbed) ───────────
# Sign up: https://sentry.io → create a Flutter project → copy DSN
# Free tier: 5K errors/mo
SENTRY_DSN=
