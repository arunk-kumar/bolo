# ── Secrets & environment ─────────────────────────────────────────
.env
.env.local
.env.*.local
*.key
*.pem
secrets/

# ── macOS ─────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*

# ── Editors / IDEs ────────────────────────────────────────────────
.idea/
.vscode/
!.vscode/extensions.json
!.vscode/settings.recommended.json
*.iml
*.iws
.metals/
.metals.log
.bloop/

# ── Flutter / Dart ────────────────────────────────────────────────
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/.packages
app/.pub-cache/
app/.pub/
app/build/
app/coverage/
app/pubspec.lock             # (Flutter apps: uncomment if you want deterministic builds; leave gitignored for libraries)
app/**/generated_plugin_registrant.dart
app/**/*.g.dart              # generated by build_runner (Riverpod, Isar)
app/**/*.freezed.dart
app/**/*.mocks.dart

# ── iOS (kept ignored even in Android-only Plan B; if we later add iOS these still apply) ──
app/ios/Pods/
app/ios/.symlinks/
app/ios/Flutter/Flutter.framework
app/ios/Flutter/Flutter.podspec
app/ios/build/
app/ios/**/*.xcworkspace/xcuserdata/
app/ios/**/*.xcodeproj/xcuserdata/

# ── Android ───────────────────────────────────────────────────────
app/android/.gradle/
app/android/local.properties
app/android/**/GeneratedPluginRegistrant.java
app/android/key.properties
app/android/*.jks
app/android/*.keystore
app/android/app/upload-keystore.jks
app/android/app/debug-keystore.jks

# ── Build outputs ─────────────────────────────────────────────────
*.apk
*.aab
*.ipa
*.dSYM.zip
*.dSYM/

# ── Python (TTS scripts) ──────────────────────────────────────────
scripts/__pycache__/
scripts/*.pyc
scripts/.venv/
scripts/venv/
scripts/.pytest_cache/
scripts/.tts_cache_debug/    # local debug output; the real .tts_cache/ folder IS committed
# Downloaded Piper voice models (~50 MB each, not in repo) — keep README so
# a fresh clone knows how to fetch them.
scripts/piper_models/*
!scripts/piper_models/README.md

# ── Node (in case we add a landing page later) ────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Logs / temp ───────────────────────────────────────────────────
*.log
*.tmp
*.swp
.tmp/
tmp/
