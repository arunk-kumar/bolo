# ── Git LFS tracking rules ────────────────────────────────────────
# Binary assets are stored via Git LFS to keep the repository lean.
# Run `git lfs install` once per clone; then these rules apply on every
# add/commit.

# Audio
*.mp3   filter=lfs diff=lfs merge=lfs -text
*.wav   filter=lfs diff=lfs merge=lfs -text
*.ogg   filter=lfs diff=lfs merge=lfs -text
*.m4a   filter=lfs diff=lfs merge=lfs -text

# Raster images (word illustrations, scene backgrounds)
*.png   filter=lfs diff=lfs merge=lfs -text
*.jpg   filter=lfs diff=lfs merge=lfs -text
*.jpeg  filter=lfs diff=lfs merge=lfs -text
*.webp  filter=lfs diff=lfs merge=lfs -text

# Animation binaries
*.riv   filter=lfs diff=lfs merge=lfs -text
*.json.lottie filter=lfs diff=lfs merge=lfs -text

# Fonts
*.ttf   filter=lfs diff=lfs merge=lfs -text
*.otf   filter=lfs diff=lfs merge=lfs -text
*.woff2 filter=lfs diff=lfs merge=lfs -text

# Videos (if we ever add mouth-model reference videos)
*.mp4   filter=lfs diff=lfs merge=lfs -text
*.mov   filter=lfs diff=lfs merge=lfs -text

# Archives, keystores, signed builds — never track in Git anyway, but
# safety net in case they slip past .gitignore
*.zip   filter=lfs diff=lfs merge=lfs -text
*.tar.gz filter=lfs diff=lfs merge=lfs -text

# ── Line-ending normalization ─────────────────────────────────────
# Ensure text files use LF on all platforms — critical when developing
# across macOS/Linux and Windows contributors.
*.dart      text eol=lf
*.py        text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.gradle    text eol=lf
*.xml       text eol=lf
